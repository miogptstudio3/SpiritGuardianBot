BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
DATABASE_URL=postgresql://postgres:password@localhost:5432/spirits
ADMIN_IDS=123456789

# چند شناسه را با کاما جدا کنید؛ اولین شناسه به عنوان سازنده اصلی (ویژه) شناخته می‌شود.
# مثال: ADMIN_IDS=6227792513,111111111,222222222
# یا صراحتاً: CREATOR_ID=6227792513

# اتصال PostgreSQL: DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# (postgres:// هم پشتیبانی می‌شود)
